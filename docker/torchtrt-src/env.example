# Copy to docker/torchtrt-src/.env and adjust as needed.
#
#   cp docker/torchtrt-src/env.example docker/torchtrt-src/.env

# Clone source into a temp dir inside the container (no local checkout required)
TORCH_TRT_REPO=https://github.com/pytorch/TensorRT.git
# Must match container torch (2.10+cu130). main requires torch>=2.14.
TORCH_TRT_REF=v2.10.0
# Set to 1 to leave the clone under /tmp/torchtrt-src.* after the build
TORCH_TRT_KEEP_SRC=0

# Packaged TensorRT tree with include/ + lib/ used to compile against DriveOS TRT.
# (Runtime .debs on Thor do not install NvInfer.h under /usr/include.)
TENSORRT_PKG_ROOT=/gtl/managed/builds/TensorRT-10.14.2.2

# Persist the opt wheel on the host (default is docker/torchtrt-src/artifacts)
# ARTIFACT_DIR=/home/mwilliams/test/TRT-VLA-Lowering/docker/torchtrt-src/artifacts

# Reuse the existing Thor VLA image as the base (has torch 2.10+cu130)
BASE_IMAGE=trt-vla-thor:7.0.5-cu130-trt10.14

# Image produced by ./docker/torchtrt-src/build.sh
IMAGE_NAME=trt-vla-torchtrt-src
IMAGE_TAG=thor-opt

# Same host identity / GPU access pattern as docker/thor
HOST_UID=1216
HOST_GID=1501
HOST_USER=mwilliams
TRT_VLA_RUN_AS_ROOT=1

# Opt install uses: pip install .  (NOT pip install -e .)
COMPILATION_MODE=opt

# Patch cloned MODULE.bazel to use TENSORRT_PKG_ROOT instead of downloaded TRT 11 tarballs
USE_HOST_TENSORRT=1
