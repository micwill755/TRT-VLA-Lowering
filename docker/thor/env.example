# Copy to docker/thor/.env and adjust paths for your Thor device.
#
#   cp docker/thor/env.example docker/thor/.env

# Host workspace roots (bind-mounted into the container)
TRT_VLA_ROOT=/home/mwilliams/test/TRT-VLA-Lowering
LEROBOT_ROOT=/home/mwilliams/test/lerobot

# Built TensorRT Edge-LLM plugin (required for export scripts)
EDGE_LLM_PLUGIN_SO=/home/mwilliams/tensorrt-edge-llm/build-plugin-trt10/libNvInfer_edgellm_plugin.so.1.0

# Optional: engine output directory
ENGINE_DIR=/gtl/pi05_edge_llm

# Container image tag
IMAGE_NAME=trt-vla-thor
IMAGE_TAG=7.0.5-cu130-trt10.14

# Run as host user (recommended)
HOST_UID=1216
HOST_GID=1501
HOST_USER=mwilliams

# Run container as root so Thor GPU driver libs (libcuda, libnvrm_*) load correctly
TRT_VLA_RUN_AS_ROOT=1

# Prefer docker/torchtrt-src/artifacts/*.whl when present (opt source build).
# Set to 0 to force the image's pip torch-tensorrt wheel.
# TRT_VLA_USE_ARTIFACT_TORCHTRT=1

# HuggingFace token for gated models (set in docker/thor/.env, not committed)
# HF_TOKEN=hf_...
