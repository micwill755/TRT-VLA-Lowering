# Copy to docker/desktop/.env on a desktop GPU machine (e.g. RTX 5090):
#
#   cp docker/desktop/env.example docker/desktop/.env

# Host workspace roots (bind-mounted into the container)
TRT_VLA_ROOT=/home/micwilliams/workspace/Test/TRT-VLA-Lowering
LEROBOT_ROOT=/home/micwilliams/workspace/lerobot

# Edge-LLM plugin built for TRT 10.14 on x86_64 (NOT the TRT 11 plugin)
EDGE_LLM_PLUGIN_SO=/path/to/tensorrt-edge-llm/build-plugin-trt10/libNvInfer_edgellm_plugin.so.1.0

# Engine output (use a path with tens of GB free — language.engine is ~9 GB)
ENGINE_DIR=/tmp/pi05_edge_llm

# Desktop parity image (matches Thor stack: torch 2.10 + TRT 10.14)
DESKTOP_IMAGE_NAME=trt-vla-desktop
DESKTOP_IMAGE_TAG=2.10-cu130-trt10.14

HOST_UID=1000
HOST_GID=1000
HOST_USER=micwilliams

# Set to 1 to match Thor cuDNN-disabled behavior inside the same container stack
TRT_VLA_THOR=0

# HuggingFace token for gated models
# HF_TOKEN=hf_...
